                    "Type": {
                      "type": "string",
                      "not": {
                        "const": "NaN"
                      }
                    }
                  },
                  "required": [
                    "Type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "string"
                }
              ],
              "not": {
                "const": "NaN"
