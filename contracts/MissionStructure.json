{
  "title": "FAST Mission Profile Schema",
  "description": "Schema for Future Aircraft Sizing Tool (FAST) mission profile input structures. Arrays should be column-vector-equivalent and have compatible lengths.",
  "type": "object",
  "required": ["Target", "Segs", "ID", "AltBeg", "AltEnd", "ClbRate", "VelBeg", "VelEnd", "TypeBeg", "TypeEnd"],
  "additionalProperties": false,
  "properties": {
    "Target": {
      "type": "object",
      "required": ["Valu", "Type"],
      "additionalProperties": false,
      "properties": {
        "Valu": {
          "$ref": "#/$defs/numberVector",
          "description": "Mission target value. Use meters for distance targets and minutes for time targets.",
          "units": "m or min"
        },
        "Type": {
          "$ref": "#/$defs/targetTypeVector",
          "description": "Mission target type.",
          "units": "unitless"
        }
      }
    },
    "Segs": {
      "$ref": "#/$defs/segmentVector",
      "description": "Ordered mission segment names.",
      "units": "unitless"
    },
    "ID": {
      "$ref": "#/$defs/integerVector",
      "description": "Mission identifier for each segment. Segments in the same mission should be consecutive.",
      "units": "count"
    },
    "AltBeg": {
      "$ref": "#/$defs/numberVector",
      "description": "Beginning altitude for each segment.",
      "units": "m"
    },
    "AltEnd": {
      "$ref": "#/$defs/numberVector",
      "description": "Ending altitude for each segment.",
      "units": "m"
    },
    "ClbRate": {
      "$ref": "#/$defs/nullableNumberVector",
      "description": "Climb rate for each segment. Use null in JSON where MATLAB inputs use NaN.",
      "units": "m/s"
    },
    "VelBeg": {
      "$ref": "#/$defs/numberVector",
      "description": "Beginning speed for each segment. Units are m/s when corresponding TypeBeg is TAS or EAS, and Mach when TypeBeg is Mach.",
      "units": "m/s or Mach"
    },
    "VelEnd": {
      "$ref": "#/$defs/numberVector",
      "description": "Ending speed for each segment. Units are m/s when corresponding TypeEnd is TAS or EAS, and Mach when TypeEnd is Mach.",
      "units": "m/s or Mach"
    },
    "TypeBeg": {
      "$ref": "#/$defs/velocityTypeVector",
      "description": "Beginning speed type for each segment.",
      "units": "unitless"
    },
    "TypeEnd": {
      "$ref": "#/$defs/velocityTypeVector",
      "description": "Ending speed type for each segment.",
      "units": "unitless"
    },
    "PowerOpt": {
      "$ref": "#/$defs/flagVector",
      "description": "Power optimization flag used by some mission profiles.",
      "units": "unitless"
    },
    "SegEnd": {
      "$ref": "#/$defs/integerVector",
      "description": "Processed segment-end indices. Usually generated by FAST rather than user-authored.",
      "units": "count"
    }
  },
  "$defs": {
    "numberVector": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "nullableNumberVector": {
      "oneOf": [
        {
          "type": ["number", "null"]
        },
        {
          "type": "array",
          "items": {
            "type": ["number", "null"]
          }
        }
      ]
    },
    "integerVector": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      ]
    },
    "flagVector": {
      "oneOf": [
        {
          "type": ["integer", "boolean"]
        },
        {
          "type": "array",
          "items": {
            "type": ["integer", "boolean"]
          }
        }
      ]
    },
    "segmentVector": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["Takeoff", "Climb", "Cruise", "Descent", "Landing"]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Takeoff", "Climb", "Cruise", "Descent", "Landing"]
          }
        }
      ]
    },
    "targetTypeVector": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["Dist", "Time"]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Dist", "Time"]
          }
        }
      ]
    },
    "velocityTypeVector": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["TAS", "EAS", "Mach"]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["TAS", "EAS", "Mach"]
          }
        }
      ]
    }
  }
}
